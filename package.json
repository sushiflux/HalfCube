{
  "name": "partcraft",
  "version": "0.0.0",
  "private": true,
  "description": "Source-available parametric 3D CAD program",
  "license": "SEE LICENSE IN LICENSE",
  "author": "SushiFlux",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "_build/desktop/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.desktop.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --type-aware --deny-warnings app desktop config scripts tests playwright.config.ts vite.config.ts vite.desktop.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:local": "node tests/e2e/run.mjs --local",
    "check:protocol": "node protocol/generate.mjs --check",
    "notices": "node scripts/notices/generate.ts",
    "check:notices": "node scripts/notices/generate.ts --check",
    "check:notices-bundle": "node scripts/notices/verify-bundle.ts",
    "ci:checks": "npm run typecheck && npm run lint && npm test && npm run check:protocol",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "preview:web": "vite preview --config vite.config.ts",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "start:desktop": "electron .",
    "make:icons": "node scripts/make-icons.mjs",
    "make:theme-css": "node tests/unit/theme/generate-css.ts"
  },
  "dependencies": {
    "motion": "14.14.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "playwright-core": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
