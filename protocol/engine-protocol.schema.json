{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:partcraft:engine-protocol:1",
  "title": "Partcraft engine message protocol, version 1",
  "description": "Generated by protocol/generate.mjs from protocol/engine-protocol.json. Do not edit; change the source and run \"node protocol/generate.mjs\". Entry points: #/$defs/command and #/$defs/engineMessage. A message is a UTF-8 JSON header plus an optional binary payload. Commands go from the client to the engine and carry a client-chosen request id; every engine message that answers a command carries that id as replyTo. Desktop: the engine is a child process, both directions use length-prefixed frames on stdin/stdout. Browser: the engine is a WebAssembly module in a Web Worker; header and payload are passed as (string, ArrayBuffer | null).",
  "$defs": {
    "requestId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "EngineInfo": {
      "description": "What the engine is and how it was built.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "versionFull",
        "buildType",
        "platform",
        "os",
        "compiler",
        "testCommands"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "partcraft-engine"
        },
        "version": {
          "description": "Short product version of the build (first line of version.txt), e.g. v2026.11.4.",
          "type": "string"
        },
        "versionFull": {
          "description": "Full build version (second line of version.txt).",
          "type": "string"
        },
        "buildType": {
          "description": "CMake build type, e.g. Release.",
          "type": "string"
        },
        "platform": {
          "description": "native = separate desktop process, wasm = WebAssembly module in a worker.",
          "type": "string",
          "enum": [
            "native",
            "wasm"
          ]
        },
        "os": {
          "description": "Target, e.g. windows-x64, linux-x64, wasm32.",
          "type": "string"
        },
        "compiler": {
          "description": "Compiler and version.",
          "type": "string"
        },
        "testCommands": {
          "description": "true when the engine was built with test commands (diagnostics.crash, diagnostics.hang).",
          "type": "boolean"
        }
      }
    },
    "PlanegcsInfo": {
      "description": "Source of the bundled planegcs sketch solver.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "commit"
      ],
      "properties": {
        "source": {
          "description": "Project and release the solver sources come from, e.g. FreeCAD 1.1.4.",
          "type": "string"
        },
        "commit": {
          "description": "Full git commit of those sources.",
          "type": "string"
        }
      }
    },
    "ComponentVersions": {
      "description": "Versions of the libraries compiled into the engine.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occt",
        "planegcs",
        "eigen",
        "boost",
        "nlohmannJson"
      ],
      "properties": {
        "occt": {
          "description": "Open CASCADE Technology version.",
          "type": "string"
        },
        "planegcs": {
          "$ref": "#/$defs/PlanegcsInfo"
        },
        "eigen": {
          "type": "string"
        },
        "boost": {
          "type": "string"
        },
        "nlohmannJson": {
          "type": "string"
        }
      }
    },
    "Capabilities": {
      "description": "What the transport of this engine can do.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pingWhileBusy",
        "cancelWhileBusy"
      ],
      "properties": {
        "pingWhileBusy": {
          "description": "ping and cancel are answered while a command runs (native: reader thread). The WebAssembly engine answers only between commands.",
          "type": "boolean"
        },
        "cancelWhileBusy": {
          "description": "cancel reaches a running command (native always; WebAssembly only with a shared cancel flag).",
          "type": "boolean"
        }
      }
    },
    "Limits": {
      "description": "Message limits of this engine.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxHeaderBytes",
        "maxPayloadBytes",
        "payloadAlignment",
        "maxRequestId"
      ],
      "properties": {
        "maxHeaderBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxPayloadBytes": {
          "type": "integer",
          "minimum": 0
        },
        "payloadAlignment": {
          "type": "integer",
          "minimum": 1
        },
        "maxRequestId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "KernelSelftestStep": {
      "description": "One modelling operation of the kernel self-test with its validity and plausibility check.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "valid",
        "volume",
        "expectedVolume",
        "faceCount",
        "expectedFaceCount",
        "solidCount",
        "timeMs"
      ],
      "properties": {
        "name": {
          "description": "box, hole or fillet.",
          "type": "string"
        },
        "valid": {
          "description": "BRepCheck_Analyzer reports the result as valid.",
          "type": "boolean"
        },
        "volume": {
          "description": "Volume of the result in mm^3.",
          "type": "number"
        },
        "expectedVolume": {
          "description": "Volume computed by hand (closed form) in mm^3.",
          "type": "number"
        },
        "faceCount": {
          "type": "integer",
          "minimum": 0
        },
        "expectedFaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "solidCount": {
          "type": "integer",
          "minimum": 0
        },
        "timeMs": {
          "type": "number",
          "minimum": 0
        },
        "problem": {
          "description": "Why the step failed; missing when it passed.",
          "type": "string"
        }
      }
    },
    "HelloCommand": {
      "description": "First command of every connection. Compares the protocol version; every other command is refused before it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "protocol",
        "client"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "protocol": {
          "description": "Protocol version the client speaks.",
          "type": "integer"
        },
        "client": {
          "description": "Free text naming the client and its version, for diagnostics.",
          "type": "string"
        }
      }
    },
    "PingCommand": {
      "description": "Liveness check. The native engine answers while it computes; the WebAssembly engine only between commands.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "ping"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        }
      }
    },
    "CancelCommand": {
      "description": "Cancels a queued or running command. The cancelled command answers with error code cancelled.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "target"
      ],
      "properties": {
        "type": {
          "const": "cancel"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "target": {
          "description": "Id of the command to cancel.",
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "ShutdownCommand": {
      "description": "Runs after the commands queued before it, answers bye; the native engine then exits with code 0.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "shutdown"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        }
      }
    },
    "DiagnosticsKernelSelftestCommand": {
      "description": "Builds a block 80 x 50 x 20 mm with a through hole of 20 mm and a 3 mm fillet on the top hole edge, and checks every operation with BRepCheck_Analyzer plus volume and face count against closed-form values.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "diagnostics.kernelSelftest"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        }
      }
    },
    "DiagnosticsSolverSelftestCommand": {
      "description": "Solves a fixed, fully constrained sketch (rectangle 60 x 40 mm with a tangent arc of diameter 20 mm and a line angle) with planegcs DogLeg and verifies the result with independent geometry checks.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "diagnostics.solverSelftest"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        }
      }
    },
    "DiagnosticsCrashCommand": {
      "description": "Test only: ends the engine on purpose (native: the process dies; WebAssembly: a trap). Used to test the desktop supervisor and the worker restart.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "mode"
      ],
      "properties": {
        "type": {
          "const": "diagnostics.crash"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "mode": {
          "description": "abort = std::abort, nullcall = call through a null function pointer, intdiv = integer division by zero.",
          "type": "string",
          "enum": [
            "abort",
            "nullcall",
            "intdiv"
          ]
        }
      }
    },
    "DiagnosticsHangCommand": {
      "description": "Test only. busy: the command computes for ms milliseconds (or until cancelled when ms is missing) and answers hangResult; ping is still answered natively. frozen: the engine stops answering anything, including ping, until it is killed (desktop supervisor and browser watchdog tests).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "mode"
      ],
      "properties": {
        "type": {
          "const": "diagnostics.hang"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "mode": {
          "type": "string",
          "enum": [
            "busy",
            "frozen"
          ]
        },
        "ms": {
          "description": "busy only: duration; missing = until cancelled.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "HelloResult": {
      "description": "Answer to hello.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "replyTo",
        "protocol",
        "engine",
        "components",
        "capabilities",
        "limits"
      ],
      "properties": {
        "type": {
          "const": "helloResult"
        },
        "replyTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "type": "integer"
        },
        "engine": {
          "$ref": "#/$defs/EngineInfo"
        },
        "components": {
          "$ref": "#/$defs/ComponentVersions"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        }
      }
    },
    "Pong": {
      "description": "Answer to ping.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "replyTo",
        "busyWith",
        "queued"
      ],
      "properties": {
        "type": {
          "const": "pong"
        },
        "replyTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "busyWith": {
          "description": "Id of the running command, null when idle.",
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "queued": {
          "description": "Commands waiting in the queue.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CancelResult": {
      "description": "Answer to cancel. The cancelled command itself answers with error code cancelled.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "replyTo",
        "target",
        "state"
      ],
      "properties": {
        "type": {
          "const": "cancelResult"
        },
        "replyTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "description": "Where the target was: still queued, running, or neither (already answered or unknown).",
          "type": "string",
          "enum": [
            "queued",
            "running",
            "notFound"
          ]
        }
      }
    },
    "Bye": {
      "description": "Answer to shutdown.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "replyTo"
      ],
      "properties": {
        "type": {
          "const": "bye"
        },
        "replyTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "KernelSelftestResult": {
      "description": "Answer to diagnostics.kernelSelftest. A failed check is a normal answer with passed = false.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "replyTo",
        "passed",
        "volume",
        "expectedVolume",
        "faceCount",
        "expectedFaceCount",
        "volumeTolerance",
        "steps",
        "timeMs"
      ],
      "properties": {
        "type": {
          "const": "kernelSelftestResult"
        },
        "replyTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "problem": {
          "description": "First failure in plain words; missing when passed.",
          "type": "string"
        },
        "volume": {
          "description": "Volume of the final body in mm^3 (0 when no body was built).",
          "type": "number"
        },
        "expectedVolume": {
          "type": "number"
        },
        "faceCount": {
          "type": "integer",
          "minimum": 0
        },
        "expectedFaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "volumeTolerance": {
          "description": "Allowed relative volume deviation.",
          "type": "number"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KernelSelftestStep"
          }
        },
        "timeMs": {
          "description": "Time of all operations and checks.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "SolverSelftestResult": {
      "description": "Answer to diagnostics.solverSelftest. A failed check is a normal answer with passed = false.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "replyTo",
        "passed",
        "status",
        "algorithm",
        "dof",
        "expectedDof",
        "conflicting",
        "redundant",
        "maxResidual",
        "residualTolerance",
        "maxDeviation",
        "reference",
        "parameterCount",
        "constraintCount",
        "timeMs"
      ],
      "properties": {
        "type": {
          "const": "solverSelftestResult"
        },
        "replyTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "problem": {
          "description": "First failure in plain words; missing when passed.",
          "type": "string"
        },
        "status": {
          "description": "Solver outcome.",
          "type": "string",
          "enum": [
            "solved",
            "failed",
            "conflicting",
            "redundant"
          ]
        },
        "algorithm": {
          "type": "string",
          "const": "DogLeg"
        },
        "dof": {
          "description": "Remaining degrees of freedom reported by planegcs.",
          "type": "integer"
        },
        "expectedDof": {
          "type": "integer"
        },
        "conflicting": {
          "description": "Ids of conflicting constraints.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redundant": {
          "description": "Ids of redundant constraints.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxResidual": {
          "description": "Largest constraint residual, computed independently of planegcs from the solved geometry (mm or rad).",
          "type": "number"
        },
        "residualTolerance": {
          "type": "number"
        },
        "maxDeviation": {
          "description": "Largest distance of a solved point or radius from its closed-form value (mm).",
          "type": "number"
        },
        "reference": {
          "description": "Reference dimensions measured after solving (never given to the solver), by constraint id.",
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "parameterCount": {
          "description": "Solver parameters (one contiguous block).",
          "type": "integer",
          "minimum": 0
        },
        "constraintCount": {
          "type": "integer",
          "minimum": 0
        },
        "timeMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "HangResult": {
      "description": "Answer to diagnostics.hang in busy mode.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "replyTo",
        "mode",
        "ms"
      ],
      "properties": {
        "type": {
          "const": "hangResult"
        },
        "replyTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "busy"
          ]
        },
        "ms": {
          "description": "How long the command actually ran.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ErrorMessage": {
      "description": "Failure of a command, or of a message that could not be read (then replyTo is null).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "replyTo",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "replyTo": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "protocol_mismatch",
            "not_initialized",
            "bad_message",
            "unknown_command",
            "test_commands_disabled",
            "cancelled",
            "crash_not_triggered",
            "internal"
          ]
        },
        "message": {
          "description": "Complete, specific cause written by the engine.",
          "type": "string"
        },
        "detail": {
          "description": "Raw technical text (exception type and text), when there is one.",
          "type": "string"
        },
        "command": {
          "description": "Type of the failed command, when known.",
          "type": "string"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloCommand"
        },
        {
          "$ref": "#/$defs/PingCommand"
        },
        {
          "$ref": "#/$defs/CancelCommand"
        },
        {
          "$ref": "#/$defs/ShutdownCommand"
        },
        {
          "$ref": "#/$defs/DiagnosticsKernelSelftestCommand"
        },
        {
          "$ref": "#/$defs/DiagnosticsSolverSelftestCommand"
        },
        {
          "$ref": "#/$defs/DiagnosticsCrashCommand"
        },
        {
          "$ref": "#/$defs/DiagnosticsHangCommand"
        }
      ]
    },
    "engineMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloResult"
        },
        {
          "$ref": "#/$defs/Pong"
        },
        {
          "$ref": "#/$defs/CancelResult"
        },
        {
          "$ref": "#/$defs/Bye"
        },
        {
          "$ref": "#/$defs/KernelSelftestResult"
        },
        {
          "$ref": "#/$defs/SolverSelftestResult"
        },
        {
          "$ref": "#/$defs/HangResult"
        },
        {
          "$ref": "#/$defs/ErrorMessage"
        }
      ]
    }
  }
}
